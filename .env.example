# Copy to `.env.local` and fill in. Both values come from the Supabase
# dashboard: Project Settings → API.
#
# Leave them empty and Lumen runs exactly as before — local only, no account
# screen, no network. Sync is additive, never required.

VITE_SUPABASE_URL=https://your-project.supabase.co

# The anon / publishable key. It is meant to be public: every table has row
# level security, so this key can only reach rows belonging to whoever is
# signed in. Never put the *service_role* key here — that one bypasses RLS.
VITE_SUPABASE_ANON_KEY=your-anon-key
