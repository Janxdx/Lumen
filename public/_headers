# Cloudflare Pages headers.
#
# The build hashes every asset filename, so assets can be cached forever.
# The two files that must never be stale are the entry document and the
# service worker — otherwise an iPad keeps booting an old app and never sees
# a new deploy.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
